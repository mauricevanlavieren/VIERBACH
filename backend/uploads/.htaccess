# Geen directory-listing en NOOIT scripts uitvoeren in de uploadmap
Options -Indexes -ExecCGI

<FilesMatch "\.(php|php3|php4|php5|php7|phtml|phar|cgi|pl|py|sh)$">
  Require all denied
</FilesMatch>
RemoveHandler .php .phtml .php3 .php4 .php5

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
  <FilesMatch "\.(php|php3|php4|php5|php7|phtml|phar|cgi|pl|py|sh)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
